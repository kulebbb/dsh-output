{
  "name": "@kulebbb/dsh-output",
  "version": "0.1.0",
  "description": "DSH 右栏「产出物」tab：汇总当前会话交付给用户的文件，可在右栏预览、用默认应用打开或在 Finder 中定位。",
  "license": "MIT",
  "author": "kulebbb",
  "homepage": "https://github.com/kulebbb/dsh-output#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kulebbb/dsh-output.git"
  },
  "bugs": {
    "url": "https://github.com/kulebbb/dsh-output/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "sidebar",
    "deliverables"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "@types/react": "18.3.28",
    "react": "18.3.1",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
